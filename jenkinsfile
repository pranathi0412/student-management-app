pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/your-username/student-management-app.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t student-management-app:latest .'
            }
        }

        stage('Deploy Container') {
            steps {
                sh '''
                    docker stop student-app || true
                    docker rm student-app || true
                    docker run -d -p 8080:8080 --name student-app student-management-app:latest
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}